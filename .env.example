# Copy to .env (in this folder, or the folder above it) and fill in. Never commit .env.
PORTKEY_API_KEY=your-portkey-key-here
OPENAI_BASE_URL=https://api.portkey.ai/v1
MODEL_NAME=gpt-6-luna

# Optional
# OPENAI_API_KEY=            # only if you use your own OpenAI key instead of Portkey
# DAILY_TOKEN_BUDGET=1500000 # all agents combined; agents stop for the day when reached
# MONTHLY_COST_BUDGET_USD=25
# PAITAQ_TARGETS_CSV=data/full/targets.csv   # the full Paitaq mapping export (see README)
# PAITAQ_CONTACTS_CSV=data/full/contacts.csv

# Optional: pull Zoom AI Companion meeting summaries directly (Server-to-Server OAuth app).
# Without these, paste/upload the summary from Zoom's recap email.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_USER=me

# Optional: the app's own LinkedIn window (its own browser profile, separate from your Chrome).
# Also run: pip install -r requirements-linkedin.txt && python -m playwright install chromium
# LINKEDIN_BROWSER=1
# LINKEDIN_BROWSER_CHANNEL=chrome   # use your installed Chrome (still its own separate profile) instead of Playwright's Chromium
# LINKEDIN_OWNER=Mary               # whose connections the window searches
